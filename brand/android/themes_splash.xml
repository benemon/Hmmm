<?xml version="1.0" encoding="utf-8"?>
<!-- values/themes.xml fragment. windowSplashScreenBackground uses surface, not surfaceRaised. -->
<resources>
    <style name="Theme.Hmmm.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hmmm_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_light</item>
        <item name="postSplashScreenTheme">@style/Theme.Hmmm</item>
    </style>
</resources>
<!-- values/colors.xml: hmmm_surface = #FBFAF7 (light), #131311 (night) -->
