<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform splash (API 31+): monogram on surface; night variants resolve
         via the colour and drawable qualifiers. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/hmmm_surface</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
